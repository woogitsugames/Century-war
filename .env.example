# Dwa NIEZALEŻNE klucze: dla CW_PUBLIC_ID_KEY nie używaj wartości z APK.
# Każdy klucz osobno: openssl rand -hex 32. Zapisz poza repozytorium.
CW_HMAC_KEY=ZASTAP_LOSOWYM_KLUCZEM_64_ZNAKI
CW_PUBLIC_ID_KEY=ZASTAP_DRUGIM_LOSOWYM_KLUCZEM_64_ZNAKI
# Tylko dokładny IP Caddy widziany przez proces serwera; bez prefiksów CIDR.
CW_TRUSTED_PROXY_IPS=127.0.0.1
CW_RATE_POST_IP=20
CW_RATE_DELETE_IP=20
CW_RATE_READ_IP=120
CW_RATE_REPORT_IP=5
CW_RATE_POST_PLAYER=6
# Opcjonalny prywatny token GET /metrics; wygeneruj: openssl rand -hex 32
# Puste = endpoint /metrics wyłączony.
CW_METRICS_TOKEN=

# Dzienne limity zapisów (UTC, trwałe w SQLite).
CW_RATE_POST_INSTALL_DAY=100
CW_RATE_POST_IP_DAY=400
# Mały VPS: jeden procesor weryfikacji i maks. 512 MB sterty JVM.
CW_JAVA_TOOL_OPTIONS=-Xmx512m -XX:ActiveProcessorCount=1

# Okresy przechowywania danych rankingu w dniach (RODO); 0 = krok wyłączony.
# Wartości poniżej to propozycja do zatwierdzenia przez właściciela (docs/SERVER_DEPLOY.md §13).
# Wyniki tablic dnia i tygodnia (liczone od dnia wyzwania / końca tygodnia).
CW_RETENTION_PERIOD_DAYS=90
# Zgłoszenia nicków.
CW_RETENTION_REPORT_DAYS=180
# Gracz bez nowego wyniku przez tyle dni jest usuwany w całości (24 miesiące).
CW_RETENTION_INACTIVE_DAYS=730
# Dziennik usunięć i dziennik działań operatora.
CW_RETENTION_LOG_DAYS=400
