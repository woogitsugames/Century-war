# Dwa NIEZALEŻNE klucze: dla CW_PUBLIC_ID_KEY nie używaj wartości z APK.
# Każdy klucz osobno: openssl rand -hex 32. Zapisz poza repozytorium.
CW_HMAC_KEY=ZASTAP_LOSOWYM_KLUCZEM_64_ZNAKI
CW_PUBLIC_ID_KEY=ZASTAP_DRUGIM_LOSOWYM_KLUCZEM_64_ZNAKI
# Tylko dokładny IP Caddy widziany przez proces serwera; bez prefiksów CIDR.
CW_TRUSTED_PROXY_IPS=127.0.0.1
CW_RATE_POST_IP=20
CW_RATE_DELETE_IP=20
CW_RATE_READ_IP=120
CW_RATE_REPORT_IP=5
CW_RATE_POST_PLAYER=6
# Opcjonalny prywatny token GET /metrics; wygeneruj: openssl rand -hex 32
# Puste = endpoint /metrics wyłączony.
CW_METRICS_TOKEN=
