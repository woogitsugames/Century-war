# Zamień scores.example.com na domenę z rekordem A/AAAA prowadzącym na VPS.
# Caddy automatycznie pobierze i odnowi certyfikat HTTPS.
scores.example.com {
    request_body {
        max_size 1MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
    }
    reverse_proxy 127.0.0.1:8080 {
        # Nadpisujemy XFF adresem rzeczywistego połączenia, a nie nagłówkiem klienta.
        header_up X-Forwarded-For {remote_host}
        transport http {
            read_timeout 120s
        }
    }
}
