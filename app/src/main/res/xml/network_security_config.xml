<?xml version="1.0" encoding="utf-8"?>
<!-- Bez ruchu HTTP; tylko certyfikaty z magazynu systemowego. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
