<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11 (Auto Backup). Kopia obejmuje tylko postęp gracza: profil i historię bitew.
     Reguła include oznacza, że WSZYSTKO inne jest pominięte, w tym:
     score-queue.json i score-queue.json.deletions (kolejka wyników i żądań usunięcia),
     crash/ (dzienniki awarii), battle.snap (przerwana bitwa), replays/ (rozmiar),
     profile-backups/ (lokalne kopie sprzed importu), pliki .tmp i SharedPreferences.
     profile.json zawiera sekret rankingu; przywrócenie go na nowym telefonie tego samego
     konta Google jest świadome (docs/SECURITY.md). -->
<!-- requireFlags (Android 9+): tylko gdy kopia jest szyfrowana po stronie klienta. -->
<full-backup-content>
    <include domain="file" path="profile.json" requireFlags="clientSideEncryption" />
    <include domain="file" path="history.json" requireFlags="clientSideEncryption" />
</full-backup-content>
