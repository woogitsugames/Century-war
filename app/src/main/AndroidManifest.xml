<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=true: kopia Androida przywraca postęp na nowym telefonie (tylko
         profile.json i history.json, patrz res/xml/*_rules.xml). adb backup dla aplikacji
         z targetSdk 31+ i tak pomija dane aplikacji niedebugowalnej. -->
    <application
        android:name=".CenturyWarApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.CenturyWar">

        <!-- Bez ID nie inicjujemy PGS przez provider przed startem aplikacji. -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
        <!-- R10-04: tryb gry Androida (API 33+): gra sama reaguje na oszczędzanie baterii. -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            <!-- appCategory="game" zwalnia grę z ignorowania orientacji na dużych ekranach w Androidzie 16 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Udostępnione pliki CWR otwierane przez zewnętrzne aplikacje. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/x-centurywar-replay" />
            </intent-filter>
            <!-- Niektóre menedżery plików ustawiają własny MIME dla .cwr. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\.cwr" />
            </intent-filter>
        </activity>

        <!-- R11-04: pętla gry dla raportu przedpremierowego Google Play i Firebase Test Lab.
             Osobna Activity w osobnym procesie: zwykły start (MainActivity) bez zmian,
             profil gracza nietknięty (TestLoopActivity pisze tylko do cacheDir/testloop). -->
        <activity
            android:name=".testloop.TestLoopActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:process=":testloop"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="${applicationId}.testloop"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="com.google.intent.action.TEST_LOOP" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/javascript" />
            </intent-filter>
        </activity>
        <meta-data android:name="com.google.test.loops" android:value="4" />
        <meta-data android:name="com.google.test.loops.player_experience" android:value="1,4" />
        <meta-data android:name="com.google.test.loops.performance" android:value="2,3" />

        <provider
            android:name=".meta.ReplayShareProvider"
            android:authorities="${applicationId}.replays"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".notifications.DailyReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Telefony 21:9 i dalej, oraz Foldy: bez czarnych pasów -->
        <meta-data android:name="android.max_aspect" android:value="3.0" />
    </application>
</manifest>
